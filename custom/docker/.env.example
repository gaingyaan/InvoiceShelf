COMPOSE_PROJECT_NAME=invoiceshelf-custom
DOCKER_ENV_FILE=.env

APP_NAME=InvoiceShelf
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8090
APP_PORT=8090
APP_TIMEZONE=UTC

DB_CONNECTION=mariadb
DB_HOST=database
DB_PORT=3306
DB_DATABASE=invoiceshelf
DB_USERNAME=invoiceshelf
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password
MARIADB_IMAGE=mariadb:10

DB_VOLUME_NAME=invoiceshelf_mysql
STORAGE_VOLUME_NAME=invoiceshelf_storage
NETWORK_NAME=invoiceshelf_network

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:8090
PYTHON_BINARY=python3
