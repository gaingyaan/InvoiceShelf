# Copy this file to .env and replace every value marked CHANGE_ME.
# Do not commit custom/docker/.env.

APP_NAME=InvoiceShelf
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8090
APP_KEY=
APP_TIMEZONE=UTC

DB_CONNECTION=mariadb
DB_HOST=database
DB_PORT=3306
DB_DATABASE=invoiceshelf
DB_USERNAME=invoiceshelf
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

MARIADB_DATABASE=invoiceshelf
MARIADB_USER=invoiceshelf
MARIADB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:8090
TRUSTED_PROXIES="*"
QUEUE_CONNECTION=database
